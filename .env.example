# Kafka
KAFKA_PORT=9092

# Confluent Schema Registry
SCHEMA_REGISTRY_PORT=8081

# TimescaleDB (PostgreSQL + timescaledb extension)
# Port 5433 avoids conflict with a local PostgreSQL install on 5432
POSTGRES_USER=datasentinel
POSTGRES_PASSWORD=datasentinel
POSTGRES_DB=datasentinel
TIMESCALEDB_PORT=5433
TIMESCALEDB_DSN=postgresql://datasentinel:datasentinel@127.0.0.1:5433/datasentinel

# Kafka UI (optional — helpful for debugging)
AKHQ_PORT=8080

# Week 2 — AI agents (optional; heuristics used when unset)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=3
LLM_MAX_RETRIES=2
HEURISTIC_CONFIDENCE_THRESHOLD=0.7
REPAIR_CONFIDENCE_THRESHOLD=0.6

# Week 3 — integrations (optional)
GITHUB_TOKEN=
GITHUB_REPO=your-org/DataSentinel
SLACK_WEBHOOK_URL=
SCHEMA_REGISTRY_URL=http://localhost:8081
SCHEMA_EVOLUTION_CONFIDENCE_THRESHOLD=0.85
PROMPT_ACCURACY_THRESHOLD=0.85
